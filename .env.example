# Aucun secret ici. Copier vers .env (ignoré) pour Sepolia.
APP_MODE=sepolia
CHAIN_ID=11155111
RPC_URL=
REGISTRY_ADDRESS=
FIRMWARE_REGISTRY_ADDRESS=
DEPLOYMENT_BLOCK=
CONFIRMATION_COUNT=2
DATABASE_URL=
MQTT_URL=mqtts://broker.example.invalid:8883
MQTT_PREFIX=g25/home01
MQTT_USERNAME=
MQTT_PASSWORD=
# CA publique optionnelle si certificat non signé par une CA système.
MQTT_CA_FILE=
GATEWAY_SIGNING_KEY=
GATEWAY_SIGNER_ADDRESS=
GATEWAY_RELAYER_KEY=
# Simulateur uniquement : maps deviceId(bytes32) -> clé / identifiants MQTT.
DEVICE_KEYS_JSON=
DEVICE_MQTT_CREDENTIALS_JSON=
API_BASE_URL=https://gateway.example.invalid
IPFS_GATEWAY_URL=https://ipfs.example.invalid/ipfs
# Passerelle uniquement, API Kubo authentifiée derrière un proxy TLS.
IPFS_API_URL=
IPFS_API_TOKEN=
ALLOWED_ORIGINS=https://frontend.example.invalid
PORT=3001
# Déploiement / vérification uniquement. Ne pas injecter dans les services.
DEPLOYER_PRIVATE_KEY=
MANUFACTURER_ADDRESS=
ETHERSCAN_API_KEY=
# Frontend : seule l'URL de l'API est utilisée ; config chaîne publique via API.
VITE_API_BASE_URL=https://gateway.example.invalid

# Public provisioning map, e.g. {"LOCK-01":"0xPUBLIC_DEVICE_ADDRESS"}. No private keys.
PUBLIC_DEVICE_IDENTITIES_JSON={}

# Passerelle uniquement : gestion EMQX compatible API v5, HTTPS obligatoire.
# Laisser vide tant que le broker externe n'est pas configuré.
BROKER_PROVISIONING_DRIVER=
BROKER_API_URL=
BROKER_API_KEY=
BROKER_API_SECRET=
# Passerelle + simulateur : même clé AES-256, 64 caractères hexadécimaux.
# Génération privée : npm run broker:key
PROVISIONING_ENCRYPTION_KEY=

# Alternative gratuite flespi : BROKER_PROVISIONING_DRIVER=flespi
# Passerelle uniquement ; jeton Maître privé permettant de créer les jetons ACL.
FLESPI_TOKEN=
# MQTT_URL=mqtts://mqtt.flespi.io:8883
# MQTT_USERNAME=jeton ACL passerelle, jamais le jeton Maître ; MQTT_PASSWORD vide.

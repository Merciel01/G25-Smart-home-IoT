{
  "name": "smarthome-g25",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "test": "npm run compile && node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run compile && vite build apps/web",
    "dev": "vite apps/web --host 127.0.0.1",
    "chain": "hardhat node --hostname 127.0.0.1",
    "seed": "tsx scripts/deploy.ts --local",
    "gateway": "tsx apps/gateway/src/main.ts",
    "simulator": "tsx apps/simulator/src/main.ts",
    "deploy:sepolia": "tsx scripts/deploy.ts --sepolia",
    "test:e2e": "playwright test",
    "demo": "tsx scripts/demo.ts",
    "local:setup": "bash scripts/setup-local.sh",
    "local:broker": "tsx scripts/local-service.ts broker",
    "local:gateway": "tsx scripts/local-service.ts gateway",
    "local:simulator": "tsx scripts/local-service.ts simulator",
    "format": "prettier --write --ignore-unknown apps packages scripts tests docs/*.md README.md *.json *.ts *.yaml .github/workflows/*.yml",
    "demo:firmware": "tsx scripts/demo-firmware.ts",
    "build:web": "vite build apps/web",
    "verify:sepolia": "tsx scripts/verify-sepolia.ts",
    "mqtt:acl": "tsx scripts/mqtt-acl.ts",
    "local:fund": "tsx scripts/local-fund.ts",
    "local:identities": "tsx scripts/public-identities.ts",
    "test:transport": "tsx scripts/check-transport.ts",
    "fixtures": "tsx scripts/fixtures.ts",
    "install:local": "bash scripts/install-local.sh",
    "local:start": "node scripts/local-stack.mjs",
    "security:local": "bash scripts/security-local.sh",
    "report:pdf": ".local/tools-venv/bin/python scripts/build-report.py",
    "local:access": "tsx scripts/local-access.ts",
    "test:accounts": "tsx scripts/check-local-access.ts",
    "broker:check": "node --import tsx scripts/broker-external.ts check",
    "broker:key": "node --import tsx scripts/broker-external.ts key",
    "broker:gateway": "node --import tsx scripts/broker-external.ts gateway",
    "broker:retry": "node --import tsx scripts/broker-external.ts retry",
    "broker:transport": "node --import tsx scripts/check-external-transport.ts",
    "flespi:check": "node --import tsx scripts/flespi-check.ts",
    "flespi:transport": "node --import tsx scripts/flespi-check.ts --transport",
    "flespi:connect-local": "node --import tsx scripts/flespi-connect-local.ts",
    "db:check": "node --import tsx scripts/check-postgres.ts",
    "db:migrate": "node --import tsx scripts/check-postgres.ts --migrate",
    "hosted:start": "node scripts/hosted-stack.mjs",
    "db:test": "node --import tsx scripts/check-postgres-storage.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@openzeppelin/contracts": "5.6.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "ethers": "6.17.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "mqtt": "5.16.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "siwe": "3.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "aedes": "0.51.3",
    "hardhat": "3.21.0",
    "prettier": "3.9.10",
    "solc": "0.8.30",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "overrides": {
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  }
}
